# Copia este archivo a web/.env.local y completa los valores.
# Con Supabase local, `pnpm exec supabase status` muestra la URL y las llaves.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # solo servidor, nunca en el cliente
NEXT_PUBLIC_APP_NAME=RutaSmart
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=      # ej. 584141234567 (sin +)
CRON_SECRET=                      # cadena larga aleatoria; Vercel Cron la envía como Bearer
DEVICE_RATE_LIMIT_PER_MIN=60
